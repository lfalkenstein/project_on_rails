# Copy to .env and adjust. No API key is needed for the transport.rest APIs.

# Which upstream API to use: "db" (Deutsche Bahn) or "bvg" (Berlin)
TRANSPORT_API=db

# Base URLs (community wrappers by derhuerst, no auth required)
DB_API_BASE=https://v6.db.transport.rest
BVG_API_BASE=https://v6.bvg.transport.rest

# Path to the DuckDB warehouse file
DUCKDB_PATH=data/warehouse.duckdb
